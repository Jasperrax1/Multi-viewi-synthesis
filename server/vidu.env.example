# Copy to .env.vidu in the repository root, set file mode 600, and fill both secrets locally.
# Start from the repository root:
# node --env-file=.env.vidu --env-file-if-exists=.env.minimax server/vidu-index.mjs
# Keep both provider keys on this backend. The Android client uses only VIDU_CLIENT_TOKEN.
VIDU_API_KEY=
VIDU_CLIENT_TOKEN=

# LAN: set to this computer's private Wi-Fi IPv4. Plain HTTP is for the isolated demo only.
VIDU_HOST=127.0.0.1
VIDU_PORT=8788
VIDU_ALLOW_LAN_HTTP=0
# VIDU_TLS_CERT_FILE=/absolute/path/to/trusted-cert.pem
# VIDU_TLS_KEY_FILE=/absolute/path/to/server-key.pem

# 0 allows unlimited local jobs. A positive value caps cumulative generation attempts across restarts.
VIDU_MAX_PAID_JOBS=0
# VIDU_JOB_DIR=.runtime/vidu
# Standalone transition evaluation uses both model and resolution overrides.
# VIDU_MODEL=viduq2-pro-fast
# VIDU_RESOLUTION=720p
# VIDU_DURATION_SECONDS=2
# VIDU_PROMPT_FILE=/absolute/path/to/prompt.txt
# After an unclean shutdown, verify the PID in the job directory's .lock is no longer running
# before removing only that lock. Keep the job records so submission outcomes stay durable.
# Additional verified Vidu download hosts, exact DNS names separated by commas.
# VIDU_RESULT_HOSTS=
# Put MINIMAX_API_KEY in .env.minimax and set file mode 600.
# MINIMAX_API_REGION=cn
# MINIMAX_RESULT_HOSTS=
