# Local configuration only. Save as .env.minimax and keep file permissions at 600.
# npm run setup:mac creates this file when it does not already exist.
# Fill the API key on the deployment Mac. Never commit the completed file.
MINIMAX_API_KEY=
MINIMAX_API_REGION=cn

# Optional: additional verified result download hosts (exact DNS hostnames).
# MINIMAX_RESULT_HOSTS=
